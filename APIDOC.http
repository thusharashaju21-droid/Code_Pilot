# ========= ASSESSMENT LIST AND CREATE =============

#List all assessments
### 
GET http://127.0.0.1:8000/exams/assessment/all/
Accept: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

#Create assessment
### 
POST http://127.0.0.1:8000/exams/assessment/add/
Content-Type: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

{
    "title": "assessment 6",
    "batch": "june 2k26",
    "language": "html",
    "exam_date": "2026-10-24",
    "start_time": "11:00:00",
    "duration": 2,
    "status": "scheduled"
}


# ========= ASSESSMENT RETRIEVE, UPDATE, DELETE =============

#Retrieve one assessment
### 
GET http://127.0.0.1:8000/exams/assessment/3/
Accept: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

#Update one assessment
### 
PUT http://127.0.0.1:8000/exams/assessment/1/
Content-Type: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

{
    "title": "assessment 1",
    "batch": "june 2k26",
    "language": "html",
    "exam_date": "2026-10-23",
    "start_time": "10:00:00",
    "duration": 2,
    "status": "completed"
}

#Delete one assessment
### 
DELETE http://127.0.0.1:8000/exams/assessment/5/
Accept: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02


# ========= QUESTION CREATE, RETRIEVE, UPDATE, DELETE =============

#Add question to assessment 
### 
POST http://127.0.0.1:8000/problem/assessment/1/question/
Content-Type: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

{
    "title": "Variables in Python",
    "description": "Write a Python program to store two numbers and print their sum.",
    "score": 10,
    "assessment": 1,
    "sample_input": "10 20",
    "sample_output": "30"
}

#Retrieve one question
### 
GET http://127.0.0.1:8000/problem/question/1/
Accept: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

#Update one question
### 
PUT http://127.0.0.1:8000/problem/question/3/
Content-Type: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

{
    "title": "factorial  Number",
    "description": "write a Python program to find the factorial of a number.",
    "score": 25,
    "sample_input": "5",
    "sample_output": "120"
}

#Delete one question
### 
DELETE http://127.0.0.1:8000/problem/assessment/4/question/1/
Accept: application/json
Authorization: Token ac1fe3fec13d8c99ecfd26eb4497fc060b30fc02

